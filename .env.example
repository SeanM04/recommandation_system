# Copy to .env (git-ignored) and fill in your own values. Every setting is optional:
# with none of them the project uses a local SQLite file and the default ports, so a
# clean machine still runs with no database server.

# --- Database --------------------------------------------------------------------------
# The project database is Postgres.
DB_NAME=Telco_Dynamic_Recomender
DB_USER=postgres
DB_PASSWORD=<password>
DB_HOST=localhost
DB_PORT=5432

# Alternatively, one full SQLAlchemy URL (takes precedence over the DB_* settings):
# RECOMMENDER_DATABASE_URL=postgresql+psycopg://postgres:<password>@localhost:5432/Telco_Dynamic_Recomender

# --- python manage.py runserver --------------------------------------------------------
API_PORT=8000
DASHBOARD_PORT=8501

# --- API keys ----------------------------------------------------------------------------
# Require an X-API-Key header on every API call but /health (keys: python manage.py
# createapikey, or the dashboard's Users and API keys page).
# RECOMMENDER_REQUIRE_API_KEY=true
# The key the dashboard, simulator and benchmark send when keys are required:
# RECOMMENDER_API_KEY=rk_...

# --- Accounts ----------------------------------------------------------------------------
# Only for `python manage.py createsuperuser --noinput` (scripts, containers):
# RECOMMENDER_SUPERUSER_PASSWORD=<password>
