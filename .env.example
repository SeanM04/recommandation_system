# Copy to .env (git-ignored) and fill in your own values.
# The project database is Postgres; without these settings the project falls back
# to a local SQLite file, so a clean machine still runs with no database server.
DB_NAME=Telco_Dynamic_Recomender
DB_USER=postgres
DB_PASSWORD=<password>
DB_HOST=localhost
DB_PORT=5432

# Alternatively, one full SQLAlchemy URL (takes precedence over the DB_* settings):
# RECOMMENDER_DATABASE_URL=postgresql+psycopg://postgres:<password>@localhost:5432/Telco_Dynamic_Recomender
